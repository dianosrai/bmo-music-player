{
  "name": "bmo",
  "version": "1.0.0",
  "description": "BMO Music Player",
  "author": "BMO Developer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "music-metadata": "^11.13.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.musicplayer.mini",
    "productName": "BMO",
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "BMO",
      "runAfterFinish": false
    },
    "directories": {
      "output": "dist"
    }
  }
}
